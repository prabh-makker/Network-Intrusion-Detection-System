# ============================================================
# Backend API Configuration Template
# Copy to .env and fill in production values
# IMPORTANT: Never commit .env to version control
# ============================================================

# ============================================================
# Security
# ============================================================

# JWT secret key for token signing
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-production-secret-key-generate-with-secrets.token_urlsafe

# JWT token expiration (minutes)
JWT_EXPIRATION_MINUTES=30

# ============================================================
# Environment
# ============================================================

# Environment: development, staging, production
ENVIRONMENT=production

# Debug mode (false in production)
DEBUG=false

# ============================================================
# Database
# ============================================================

# SQLite (development): sqlite:///./nids.db
# PostgreSQL (production): postgresql://user:password@host:5432/nids
DATABASE_URL=sqlite:///./nids.db

# ============================================================
# API Configuration
# ============================================================

# CORS origins (comma-separated, no spaces)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================================
# ML Models
# ============================================================

# Model storage directory (Docker: /app/shared-models, Local: ./models)
MODEL_DIR=/app/shared-models

# Model name for inference
MODEL_NAME=nids_xgb

# ============================================================
# Optional: Email Notifications
# ============================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=alerts@nids.local

# ============================================================
# Optional: Sniffer internal API key
# Shared secret between backend and sniffer container.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, /traffic/log is unrestricted (only safe when network-isolated).
# ============================================================

SNIFFER_API_KEY=your-sniffer-api-key-here

# ============================================================
# Optional: Discord Alerts
# ============================================================

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# ============================================================
# Python Settings
# ============================================================

# Unbuffered output (needed for Docker logs)
PYTHONUNBUFFERED=1

