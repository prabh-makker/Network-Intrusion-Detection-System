{
  "openapi": "3.0.3",
  "info": {
    "title": "NIDS Sentinel API",
    "description": "AI-Powered Real-Time Network Intrusion Detection and Threat Analysis API.\n\nProvides endpoints for authentication, real-time traffic ingestion, threat alert management, GeoIP lookup, ML model metrics, and PCAP file analysis.\n\n**WebSocket endpoint** (not representable in OAS 3.0): `ws://localhost:8000/api/v1/traffic/stream?token=<jwt>` — streams live classified packet data to connected dashboard clients. Connection is closed with code 4001 if token is missing or 4003 if invalid.",
    "version": "1.0.0",
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Authentication, signup, and password recovery"
    },
    {
      "name": "Alerts",
      "description": "Threat alert retrieval, statistics, timeline, AI explainability, GeoIP, PDF export, and IP blocking"
    },
    {
      "name": "Models",
      "description": "ML model metrics, feature importances, and preprocessed traffic feature vectors"
    },
    {
      "name": "Traffic",
      "description": "Packet ingestion from the sniffer and PCAP file upload and analysis"
    }
  ],
  "security": [
    { "BearerAuth": [] }
  ],
  "paths": {
    "/api/v1/security-questions": {
      "get": {
        "operationId": "getSecurityQuestions",
        "summary": "List available security questions",
        "description": "Returns the fixed list of security questions that users must select from during signup.",
        "tags": ["Auth"],
        "security": [],
        "responses": {
          "200": {
            "description": "List of security questions for account registration",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SecurityQuestionsResponse" }
              }
            }
          },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/api/v1/login/access-token": {
      "post": {
        "operationId": "loginAccessToken",
        "summary": "Obtain a JWT access token",
        "description": "OAuth2-compatible token login using username and password form fields. Rate limited to 20 requests per minute. Returned token expires after 90 days.",
        "tags": ["Auth"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful login — returns bearer token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenResponse" }
              }
            }
          },
          "400": { "description": "Incorrect username or password, or inactive user" },
          "429": { "description": "Rate limit exceeded — max 20 requests/minute" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/api/v1/signup": {
      "post": {
        "operationId": "createUserSignup",
        "summary": "Register a new user account",
        "description": "Creates a new user with hashed password, email (required for recovery), and a security question/answer. Rate limited to 10 requests per minute.",
        "tags": ["Auth"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SignupRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          },
          "400": { "description": "Validation error — username or email already taken, or missing required fields" },
          "429": { "description": "Rate limit exceeded — max 10 requests/minute" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/api/v1/forgot/get-question": {
      "post": {
        "operationId": "getUserSecurityQuestion",
        "summary": "Retrieve a user's security question (password recovery step 1)",
        "description": "Returns the security question associated with the given username. Rate limited to 15 requests per minute.",
        "tags": ["Auth"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GetQuestionRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Security question for the given user",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SecurityQuestionResponse" }
              }
            }
          },
          "400": { "description": "No security question set for this account" },
          "404": { "description": "No account found with this username" },
          "429": { "description": "Rate limit exceeded — max 15 requests/minute" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/api/v1/forgot/reset": {
      "post": {
        "operationId": "resetPasswordWithSecurityAnswer",
        "summary": "Verify security answer and reset password (password recovery step 2)",
        "description": "Verifies the security answer (case-insensitive) and resets the user's password. Enforces an additional in-memory rate limit of 5 attempts per 10 minutes per username. Rate limited to 10 requests per minute.",
        "tags": ["Auth"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ResetPasswordRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          },
          "400": { "description": "Incorrect security answer, no security question set, or new password too short (min 4 chars)" },
          "404": { "description": "No account found with this username" },
          "429": { "description": "Too many failed attempts — locked for 10 minutes" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/api/v1/alerts/recent": {
      "get": {
        "operationId": "getRecentAlerts",
        "summary": "Fetch recent threat alerts",
        "tags": ["Alerts"],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 50, "maximum": 200 },
            "description": "Maximum number of alerts to return (capped at 200)"
          },
          {
            "name": "label",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Filter results by threat label (e.g. DoS, Probe, U2R (Root Access))"
          }
        ],
        "responses": {
          "200": {
            "description": "Ordered list of recent threat log entries (newest first)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ThreatLogEntry" }
                }
              }
            }
          },
          "401": { "description": "Unauthorized — missing or invalid credentials" },
          "403": { "description": "Forbidden — could not validate credentials" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/api/v1/alerts/stats": {
      "get": {
        "operationId": "getAlertStats",
        "summary": "Get aggregated threat statistics",
        "description": "Returns total threat count, counts grouped by label, and the top 10 attacker source IPs.",
        "tags": ["Alerts"],
        "responses": {
          "200": {
            "description": "Aggregated threat statistics",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AlertStats" }
              }
            }
          },
          "401": { "description": "Unauthorized — missing or invalid credentials" },
          "403": { "description": "Forbidden — could not validate credentials" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/api/v1/alerts/timeline": {
      "get": {
        "operationId": "getThreatTimeline",
        "summary": "Get threat counts bucketed by time period for the historical chart",
        "tags": ["Alerts"],
        "parameters": [
          {
            "name": "time_range",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["24h", "7d", "30d"],
              "default": "24h"
            },
            "description": "Time window: 24h = hourly buckets, 7d = daily buckets, 30d = daily buckets"
          }
        ],
        "responses": {
          "200": {
            "description": "Array of time-bucketed threat and traffic counts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/TimelineEntry" }
                }
              }
            }
          },
          "401": { "description": "Unauthorized — missing or invalid credentials" },
          "403": { "description": "Forbidden — could not validate credentials" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/api/v1/alerts/explain/{label}": {
      "get": {
        "operationId": "explainThreat",
        "summary": "AI explainability — why the model flagged a given threat type",
        "description": "Returns the key contributing features, severity rating, and recommended mitigation for a threat label. Data is derived from Random Forest feature importances.",
        "tags": ["Alerts"],
        "parameters": [
          {
            "name": "label",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["DoS", "DDoS (Ping of Death)", "Probe", "U2R (Root Access)"]
            },
            "description": "Threat label to explain"
          }
        ],
        "responses": {
          "200": {
            "description": "Threat explanation with key indicators, severity, and mitigation",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ThreatExplanation" }
              }
            }
          },
          "401": { "description": "Unauthorized — missing or invalid credentials" },
          "403": { "description": "Forbidden — could not validate credentials" },
          "404": { "description": "No explanation available for the given label" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/api/v1/alerts/export": {
      "get": {
        "operationId": "exportAlertsPdf",
        "summary": "Export the most recent 100 threat alerts as a downloadable PDF report",
        "tags": ["Alerts"],
        "responses": {
          "200": {
            "description": "PDF threat report",
            "headers": {
              "Content-Disposition": {
                "schema": { "type": "string" },
                "description": "attachment; filename=nids-threat-report.pdf"
              }
            },
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": { "description": "Unauthorized — missing or invalid credentials" },
          "403": { "description": "Forbidden — could not validate credentials" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/api/v1/alerts/geoip/{ip}": {
      "get": {
        "operationId": "geoipLookup",
        "summary": "Server-side GeoIP lookup for an IP address",
        "description": "Proxies the ip-api.com API to avoid CORS restrictions. Results are cached in-process (up to 1000 IPs). Returns the raw ip-api.com JSON response.",
        "tags": ["Alerts"],
        "parameters": [
          {
            "name": "ip",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "IPv4 or IPv6 address to look up"
          }
        ],
        "responses": {
          "200": {
            "description": "GeoIP data from ip-api.com (fields include status, country, countryCode, region, city, lat, lon, isp, query, etc.)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GeoIPResponse" }
              }
            }
          },
          "401": { "description": "Unauthorized — missing or invalid credentials" },
          "403": { "description": "Forbidden — could not validate credentials" },
          "502": { "description": "Bad gateway — upstream GeoIP lookup failed or timed out" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/api/v1/alerts/{alert_id}/block": {
      "post": {
        "operationId": "blockThreat",
        "summary": "Mark a threat as blocked and ban the source IP on the OS firewall",
        "description": "Sets `is_blocked = true` on the ThreatLog entry and invokes the firewall service (pfctl/iptables) to block the source IP.",
        "tags": ["Alerts"],
        "parameters": [
          {
            "name": "alert_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" },
            "description": "UUID of the alert to block"
          }
        ],
        "responses": {
          "200": {
            "description": "Threat marked blocked; firewall status indicates whether the OS-level ban succeeded",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BlockResponse" }
              }
            }
          },
          "401": { "description": "Unauthorized — missing or invalid credentials" },
          "403": { "description": "Forbidden — could not validate credentials" },
          "404": { "description": "Alert not found" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/api/v1/models/metrics": {
      "get": {
        "operationId": "getModelMetrics",
        "summary": "Return ML model info, feature importances, and accuracy metrics",
        "description": "Loads the saved XGBoost model from disk and returns its hyperparameters, feature importances, and static accuracy benchmarks computed on the KDD Cup 99 test set (99.97% overall).",
        "tags": ["Models"],
        "responses": {
          "200": {
            "description": "XGBoost model metadata and accuracy benchmarks",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ModelMetricsResponse" }
              }
            }
          },
          "401": { "description": "Unauthorized — missing or invalid credentials" },
          "403": { "description": "Forbidden — could not validate credentials" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/api/v1/models/preprocessed": {
      "get": {
        "operationId": "getPreprocessedTraffic",
        "summary": "Return recent alerts formatted as ML feature vectors",
        "description": "Fetches the most recent ThreatLog entries and derives the 12-feature ML input vector for each, suitable for display in the ML diagnostics dashboard.",
        "tags": ["Models"],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 20 },
            "description": "Number of recent alerts to return as feature vectors"
          }
        ],
        "responses": {
          "200": {
            "description": "Count and array of preprocessed packet feature vectors",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PreprocessedTrafficResponse" }
              }
            }
          },
          "401": { "description": "Unauthorized — missing or invalid credentials" },
          "403": { "description": "Forbidden — could not validate credentials" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/api/v1/traffic/log": {
      "post": {
        "operationId": "logPacket",
        "summary": "Ingest a classified packet from the sniffer",
        "description": "Called by the internal Scapy sniffer. If the packet is a threat it is persisted to the ThreatLog table. The packet is then broadcast to all connected WebSocket clients. U2R and DDoS packets with confidence ≥ 95% trigger a Discord webhook alert.",
        "tags": ["Traffic"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PacketLog" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Packet logged and broadcast to WebSocket clients",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PacketLogResponse" }
              }
            }
          },
          "400": { "description": "Invalid packet data" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/api/v1/traffic/upload-pcap": {
      "post": {
        "operationId": "uploadPcap",
        "summary": "Upload and analyze a PCAP file for historical threat detection",
        "description": "Accepts a `.pcap` file, saves it temporarily, runs the PCAP analyzer, then deletes the temp file. Returns the structured analysis results.",
        "tags": ["Traffic"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "PCAP capture file (must have .pcap extension)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "PCAP analysis completed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PcapAnalysisResponse" }
              }
            }
          },
          "400": { "description": "File is not a .pcap file, or the PCAP content is invalid/corrupt" },
          "401": { "description": "Unauthorized — missing or invalid credentials" },
          "403": { "description": "Forbidden — could not validate credentials" },
          "503": { "description": "Service unavailable — ML model not initialized on server" },
          "500": { "description": "Internal server error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "HS256-signed JWT obtained from POST /api/v1/login/access-token. Token expires after 90 days."
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string" },
          "password": { "type": "string", "format": "password" }
        }
      },
      "TokenResponse": {
        "type": "object",
        "required": ["access_token", "token_type"],
        "properties": {
          "access_token": { "type": "string" },
          "token_type": { "type": "string", "example": "bearer" }
        }
      },
      "SignupRequest": {
        "type": "object",
        "required": ["username", "password", "email", "security_question", "security_answer"],
        "properties": {
          "username": { "type": "string" },
          "password": { "type": "string", "format": "password" },
          "email": { "type": "string", "format": "email" },
          "security_question": { "type": "string" },
          "security_answer": { "type": "string" }
        }
      },
      "GetQuestionRequest": {
        "type": "object",
        "required": ["username"],
        "properties": {
          "username": { "type": "string" }
        }
      },
      "ResetPasswordRequest": {
        "type": "object",
        "required": ["username", "security_answer", "new_password"],
        "properties": {
          "username": { "type": "string" },
          "security_answer": { "type": "string" },
          "new_password": { "type": "string", "format": "password", "minLength": 4 }
        }
      },
      "SecurityQuestionsResponse": {
        "type": "object",
        "required": ["questions"],
        "properties": {
          "questions": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "SecurityQuestionResponse": {
        "type": "object",
        "required": ["question"],
        "properties": {
          "question": { "type": "string" }
        }
      },
      "MessageResponse": {
        "type": "object",
        "required": ["msg"],
        "properties": {
          "msg": { "type": "string" }
        }
      },
      "ThreatLogEntry": {
        "type": "object",
        "required": ["id", "src_ip", "dst_ip", "protocol", "label", "confidence", "is_blocked"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "timestamp": { "type": "string", "format": "date-time", "nullable": true },
          "src_ip": { "type": "string" },
          "dst_ip": { "type": "string" },
          "protocol": { "type": "string" },
          "label": { "type": "string" },
          "confidence": { "type": "number", "format": "float" },
          "is_blocked": { "type": "boolean" }
        }
      },
      "AlertStats": {
        "type": "object",
        "required": ["total_threats", "by_label", "top_sources"],
        "properties": {
          "total_threats": { "type": "integer" },
          "by_label": {
            "type": "object",
            "additionalProperties": { "type": "integer" },
            "description": "Threat counts keyed by label name"
          },
          "top_sources": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TopSource" }
          }
        }
      },
      "TopSource": {
        "type": "object",
        "required": ["ip", "count"],
        "properties": {
          "ip": { "type": "string" },
          "count": { "type": "integer" }
        }
      },
      "TimelineEntry": {
        "type": "object",
        "required": ["time", "threats", "traffic"],
        "properties": {
          "time": {
            "type": "string",
            "description": "Human-readable time label (e.g. '14:00' for 24h, 'Mon' for 7d, 'Jun 01' for 30d)"
          },
          "threats": { "type": "integer" },
          "traffic": { "type": "integer" }
        }
      },
      "ThreatKeyIndicator": {
        "type": "object",
        "required": ["feature", "impact", "detail"],
        "properties": {
          "feature": { "type": "string" },
          "impact": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
          },
          "detail": { "type": "string" }
        }
      },
      "ThreatExplanation": {
        "type": "object",
        "required": ["label", "description", "key_indicators", "severity", "mitigation"],
        "properties": {
          "label": { "type": "string" },
          "description": { "type": "string" },
          "key_indicators": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ThreatKeyIndicator" }
          },
          "severity": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
          },
          "mitigation": { "type": "string" }
        }
      },
      "BlockResponse": {
        "type": "object",
        "required": ["status", "id", "ip", "firewall_active"],
        "properties": {
          "status": { "type": "string", "example": "blocked" },
          "id": { "type": "string", "format": "uuid" },
          "ip": { "type": "string" },
          "firewall_active": { "type": "boolean" }
        }
      },
      "GeoIPResponse": {
        "type": "object",
        "additionalProperties": true,
        "description": "Raw response from ip-api.com. Common fields: status (string), country (string), countryCode (string), region (string), regionName (string), city (string), lat (number), lon (number), isp (string), query (string)."
      },
      "PacketLog": {
        "type": "object",
        "required": ["timestamp", "src_ip", "dst_ip", "protocol", "length", "label", "confidence", "is_threat"],
        "properties": {
          "timestamp": {
            "type": "number",
            "format": "float",
            "description": "Unix epoch timestamp of the captured packet"
          },
          "src_ip": { "type": "string" },
          "dst_ip": { "type": "string" },
          "protocol": { "type": "string" },
          "length": { "type": "integer" },
          "label": { "type": "string" },
          "confidence": { "type": "number", "format": "float" },
          "is_threat": { "type": "boolean" }
        }
      },
      "PacketLogResponse": {
        "type": "object",
        "required": ["status", "message"],
        "properties": {
          "status": { "type": "string", "example": "success" },
          "message": { "type": "string" }
        }
      },
      "PcapAnalysis": {
        "type": "object",
        "required": ["packets_processed", "threats_detected", "categories"],
        "properties": {
          "packets_processed": { "type": "integer" },
          "threats_detected": { "type": "integer" },
          "categories": {
            "type": "object",
            "additionalProperties": { "type": "integer" },
            "description": "Threat counts keyed by label (e.g. DoS, Probe)"
          }
        }
      },
      "PcapAnalysisResponse": {
        "type": "object",
        "required": ["status", "filename", "analysis"],
        "properties": {
          "status": { "type": "string", "example": "completed" },
          "filename": { "type": "string" },
          "analysis": { "$ref": "#/components/schemas/PcapAnalysis" }
        }
      },
      "ModelInfo": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "example": "XGBoost Classifier" },
          "n_estimators": { "type": "integer" },
          "max_depth": { "type": "integer" },
          "learning_rate": { "type": "number", "format": "float" },
          "n_features": { "type": "integer" },
          "n_classes": { "type": "integer" },
          "classes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "feature_names": {
            "type": "array",
            "items": { "type": "string" }
          },
          "feature_descriptions": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "description": "Human-readable description for each feature name"
          },
          "feature_importances": {
            "type": "object",
            "additionalProperties": { "type": "number" },
            "description": "Feature importance scores from the trained model, keyed by feature name"
          }
        }
      },
      "ClassMetrics": {
        "type": "object",
        "required": ["precision", "recall", "f1", "support"],
        "properties": {
          "precision": { "type": "number", "format": "float" },
          "recall": { "type": "number", "format": "float" },
          "f1": { "type": "number", "format": "float" },
          "support": { "type": "integer" }
        }
      },
      "AccuracyMetrics": {
        "type": "object",
        "properties": {
          "overall_accuracy": { "type": "number", "format": "float" },
          "by_class": {
            "type": "object",
            "additionalProperties": { "$ref": "#/components/schemas/ClassMetrics" },
            "description": "Per-class precision, recall, F1, and support metrics"
          },
          "confusion_matrix": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "integer" }
            },
            "description": "N×N confusion matrix; rows = actual class, cols = predicted class"
          },
          "confusion_labels": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Class labels in row/column order of the confusion matrix"
          }
        }
      },
      "ModelMetricsResponse": {
        "type": "object",
        "required": ["model", "accuracy"],
        "properties": {
          "model": { "$ref": "#/components/schemas/ModelInfo" },
          "accuracy": { "$ref": "#/components/schemas/AccuracyMetrics" }
        }
      },
      "PreprocessedPacket": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "timestamp": { "type": "string", "format": "date-time", "nullable": true },
          "src_ip": { "type": "string" },
          "dst_ip": { "type": "string" },
          "label": { "type": "string" },
          "confidence": { "type": "number", "format": "float" },
          "is_blocked": { "type": "boolean" },
          "duration": { "type": "number", "format": "float", "description": "Connection duration in seconds" },
          "protocol_type": { "type": "string", "description": "Network protocol (tcp/udp/icmp)" },
          "service": { "type": "string", "description": "Destination service (http/domain_u/ecr_i...)" },
          "flag": { "type": "string", "description": "TCP connection state flag (SF/S0...)" },
          "src_bytes": { "type": "number", "format": "float" },
          "dst_bytes": { "type": "number", "format": "float" },
          "count": { "type": "number", "format": "float" },
          "srv_count": { "type": "number", "format": "float" },
          "serror_rate": { "type": "number", "format": "float" },
          "rerror_rate": { "type": "number", "format": "float" },
          "same_srv_rate": { "type": "number", "format": "float" },
          "diff_srv_rate": { "type": "number", "format": "float" }
        }
      },
      "PreprocessedTrafficResponse": {
        "type": "object",
        "required": ["count", "packets"],
        "properties": {
          "count": { "type": "integer" },
          "packets": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PreprocessedPacket" }
          }
        }
      }
    }
  }
}
