  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Protection: Cannot edit secrets or model files'",
            "if": "Edit(.env*)|Write(.env*)|Edit(*.joblib)|Write(*.joblib)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx prettier --write {file}",
            "if": "Edit(*.tsx)|Edit(*.ts)",
            "statusMessage": "Formatting TypeScript...",
            "async": true
          },
          {
            "type": "command",
            "command": "ruff format {file}",
            "if": "Edit(*.py)",
            "statusMessage": "Formatting Python...",
            "async": true
          }
        ]
      }
    ]
  }
