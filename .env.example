# ============================================================
# NIDS Environment Configuration Template
# Copy this file to .env and fill in production values
# IMPORTANT: Never commit .env to version control
# ============================================================

# ============================================================
# Backend Configuration
# ============================================================

# Secret key for JWT token signing
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-production-secret-key-generate-with-secrets.token_urlsafe

# Database URL
# SQLite: sqlite:///./nids.db
# PostgreSQL: postgresql://user:password@host:5432/nids
DATABASE_URL=sqlite:///./nids.db

# Environment: development, staging, production
ENVIRONMENT=production

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================================
# Frontend Configuration
# ============================================================

# Backend API URL (visible to frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Node environment
NODE_ENV=production

# ============================================================
# Sniffer Configuration
# ============================================================

# Backend API endpoint for sniffer traffic
API_ENDPOINT=http://localhost:8000/api/v1/traffic/log

# Network interface (empty = all)
PACKET_INTERFACE=

# Polling interval (seconds)
POLL_INTERVAL=5

# ============================================================
# ML Models Configuration
# ============================================================

# Model directory (Docker: /app/shared-models, Local: ./models)
MODEL_DIR=/app/shared-models

# Storage volume paths
MODEL_VOLUME_PATH=./models
DB_VOLUME_PATH=./data

# ============================================================
# Security Configuration
# ============================================================

# JWT expiration (minutes)
JWT_EXPIRATION_MINUTES=30

# HTTPS redirect
HTTPS_REDIRECT=false

# HSTS max age (seconds)
HSTS_MAX_AGE=31536000

# ============================================================
# Logging Configuration
# ============================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Python logging
PYTHONUNBUFFERED=1

# ============================================================
# Optional: Email Notifications
# ============================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ============================================================
# Optional: Discord Alerts
# ============================================================

DISCORD_WEBHOOK_URL=
